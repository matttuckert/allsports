# Bundled into the app -- safe to expose (protected by RLS policies, read-only).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shared password gate. This is a soft gate, not real security -- anyone who
# decompiles the app bundle can read it. It exists to keep casual/curious
# people out, not to stop a determined one.
EXPO_PUBLIC_APP_PASSWORD=your-shared-password

# Server-side only (npm run seed). NEVER prefix with EXPO_PUBLIC_ -- this key
# bypasses RLS and must never end up in the app bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# api-sports.io dashboard (dashboard.api-football.com) -- one key works across
# all their sport products (football, american-football, basketball, etc).
API_SPORTS_KEY=your-api-sports-key
